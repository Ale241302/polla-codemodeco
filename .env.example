# ================================================================
# Polla Mundial Codemodeco 2026 — Variables de entorno
# Copia este archivo como .env y reemplaza los valores con los de TU proyecto de Supabase.
# NUNCA subas .env al repositorio. Está ignorado en .gitignore.
# ================================================================

# ----- Cliente (browser) -----
# Expuestas al navegador. Usa SOLO la anon/publishable key, nunca service_role aquí.
VITE_SUPABASE_URL="https://TU_PROYECTO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJ...anon-key..."
VITE_SUPABASE_PROJECT_ID="TU_PROYECTO"

# ----- Servidor (SSR, middleware, server functions) -----
# Mismos valores, pero sin prefijo VITE_. Usados por código que corre en el servidor.
SUPABASE_URL="https://TU_PROYECTO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="eyJ...anon-key..."

# Opcional: solo si ejecutas funciones privilegiadas desde el servidor que deban saltarse RLS.
# NO es requerido para el funcionamiento normal de la app.
# SUPABASE_SERVICE_ROLE_KEY="eyJ...service-role-key..."

# ----- Despliegue -----
# En Vercel añade también: NITRO_PRESET=vercel
